rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Horario de votación: 30/10/2026 de 16:35 a 16:55 (hora de Argentina, UTC-3).
    // Valores en milisegundos; deben coincidir con src/data/schedule.ts.
    function votingOpen() {
      return request.time >= timestamp.value(1793388900000)
        && request.time < timestamp.value(1793390100000);
    }

    match /categories/{categoryId} {

      // Un voto por usuario y categoría: el ID del documento es el uid.
      match /votes/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if votingOpen()
          && request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['candidateId', 'createdAt'])
          && request.resource.data.candidateId is string
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      // Contadores públicos. Solo se pueden sumar de 1 en 1 y únicamente
      // en la misma escritura en que se crea el voto del usuario.
      match /results/{candidateId} {
        allow read: if true;

        function myVotePath() {
          return /databases/$(database)/documents/categories/$(categoryId)/votes/$(request.auth.uid);
        }

        function votingNow() {
          return votingOpen()
            && request.auth != null
            && !exists(myVotePath())
            && getAfter(myVotePath()).data.candidateId == candidateId
            && request.resource.data.keys().hasOnly(['votes']);
        }

        allow create: if votingNow() && request.resource.data.votes == 1;
        allow update: if votingNow() && request.resource.data.votes == resource.data.votes + 1;
        allow delete: if false;
      }
    }
  }
}
